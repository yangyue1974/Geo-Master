# ---- 引擎探测 (模块 A) ----
# Perplexity Sonar 系走 OpenRouter
OPENROUTER_API_KEY=

# OpenAI 的检索走直连,不经 OpenRouter。
# spec 写的 gpt-4o-search-preview 系已从 OpenRouter 下架(2026-07-29 实测 404),
# 剩下的 openai 检索型号只有 deep-research 系 —— 单题几分钟、成本高一到两个数量级。
# 直连 Responses API + web_search 工具才是 OpenAI 现在真正的检索产品。
OPENAI_API_KEY=

# 可选:Gemini + Google Search grounding 不走 OpenRouter,直连 Google
# v0 可留空;Day 15 复测前再加入
GEMINI_API_KEY=

# 题库生成用(仅 --paraphrase / --llm-themes 时需要;不给则走纯模板确定性生成)
ANTHROPIC_API_KEY=

# ---- 索引推送 (B4) ----
# 留空则 `geo indexnow --generate-key` 会自动生成一个并写回这里
INDEXNOW_KEY=

# ---- db 捷径模式 (仅 GospelHub 自用,sitemap 模式才是主路径) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- 护栏 ----
# 单轮全量探测的 API 成本上限(美元)。超限中断并报告已完成进度。
GEO_BUDGET_USD=50

# 引擎型号(OpenRouter 在售型号会变,用环境变量覆盖而不用改代码)
GEO_MODEL_PERPLEXITY=perplexity/sonar-pro
GEO_MODEL_OPENAI_SEARCH=gpt-4.1
GEO_MODEL_GEMINI=gemini-2.5-flash
