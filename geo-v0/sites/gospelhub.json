{
  "id": "gospelhub",
  "siteName": "GospelHub",
  "siteDomain": "gospelhub.love",
  "nameVariants": ["GospelHub", "Gospel Hub", "gospelhub.love", "gospelhub"],
  "sitemap": "https://gospelhub.love/sitemap.xml",

  "_comment_patterns": "2026-07-29 用 --propose 对线上 sitemap(461 URL)实测得出。注意站点用 www. 前缀、路径为复数、slug 是 UUID —— 所以实体名只能从页面 HTML 抽,slug 兜底会产出垃圾名。没有独立歌曲页,detail 档的 song-album / credits 两个模板依赖专辑页是否带曲目表。",
  "entityPatterns": [
    { "type": "concert", "pattern": "/concerts/*" },
    { "type": "artist", "pattern": "/artists/*" },
    { "type": "album", "pattern": "/releases/*" }
  ],

  "_comment_aggregatePaths": "默认的 /releases/{year} 会撞上专辑详情页的 /releases/{uuid} 命名空间,必须改掉;/concerts/{month} 同理会撞 /concerts/{uuid}。路径顺带写成可读的答案形态,对被引用有帮助。",
  "aggregatePaths": {
    "year": "/gospel-albums/{year}",
    "theme": "/gospel-songs-about/{theme}",
    "collab": "/collaborations/{artist}",
    "newReleases": "/new-releases",
    "city": "/gospel-concerts-in/{city}",
    "month": "/gospel-concerts/{month}",
    "artistTour": "/tour/{artist}"
  },

  "vertical": {
    "noun": "gospel",
    "themes": [
      "hope",
      "grief",
      "forgiveness",
      "praise and worship",
      "gratitude",
      "faith in hard times",
      "redemption",
      "healing",
      "family",
      "surrender"
    ]
  },

  "sampling": {
    "control": 20,
    "detail": 50,
    "aggregate": 50,
    "fresh": 30
  },

  "tagline": "A structured database of gospel artists, releases, and concerts.",
  "coverage": "GospelHub tracks gospel artists, their releases, and upcoming concerts. Concert listings and new releases are maintained continuously, so they appear here before they appear in general reference sites.",

  "_comment_supabase": "仅 db 捷径模式使用,列名未经验证。sitemap 模式才是主路径 —— 未来的客户只有一个 URL。",
  "supabase": {
    "tables": [
      {
        "type": "artist",
        "table": "artists",
        "nameColumn": "name",
        "urlTemplate": "https://www.gospelhub.love/artists/{id}"
      },
      {
        "type": "album",
        "table": "releases",
        "nameColumn": "title",
        "urlTemplate": "https://www.gospelhub.love/releases/{id}"
      },
      {
        "type": "concert",
        "table": "concerts",
        "nameColumn": "title",
        "urlTemplate": "https://www.gospelhub.love/concerts/{id}"
      }
    ]
  }
}
